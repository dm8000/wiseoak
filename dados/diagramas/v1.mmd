---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	recuperar(recuperar)
	contexto(contexto)
	responder(responder)
	__end__([<p>__end__</p>]):::last
	__start__ --> recuperar;
	contexto --> responder;
	recuperar --> contexto;
	responder --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
